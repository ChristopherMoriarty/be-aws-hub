[Unit]
Description=AWS Hub
After=docker.service openvpn-server@server.service network-online.target
Requires=docker.service
Wants=openvpn-server@server.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/aws-hub
ExecStartPre=/bin/bash -c 'for i in $(seq 1 30); do ip -4 addr show dev tun0 | grep -q 10.8.0.1 && exit 0; sleep 2; done; exit 1'
ExecStart=/usr/bin/docker compose --project-directory /opt/aws-hub -f /opt/aws-hub/docker-compose.prod.yaml up -d --wait
ExecStop=/usr/bin/docker compose --project-directory /opt/aws-hub -f /opt/aws-hub/docker-compose.prod.yaml stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
